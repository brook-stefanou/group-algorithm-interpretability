__pycache__/
*.py[cod]
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.env
.venv
env/
venv/

# Jupyter
.ipynb_checkpoints

# Test / lint / type-check caches
.pytest_cache/
